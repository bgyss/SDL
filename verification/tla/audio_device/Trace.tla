------------------------------- MODULE Trace -------------------------------
(***************************************************************************)
(* Trace validation for AudioDevice (Cirstea, Kuppe, Loillier, Merz 2024): *)
(* replay one device's log from a real run of the instrumented SDL         *)
(* (verification/instrument/audio_device.patch, trace_audio.c) and check   *)
(* that every logged step is a step of the model, with the logged          *)
(* refcount, in the logged order.                                          *)
(*                                                                         *)
(* TraceData (generated by verification/instrument/trace2tla.py) defines:  *)
(*   TraceLog      the device's steps, each [t, a, v, ok]: thread, action, *)
(*                 refcount after the step (-1 if not logged), and for     *)
(*                 l_find whether it took a reference                      *)
(*   TraceLookers  one model looker per lookup that found the device       *)
(*                                                                         *)
(* Differences from AudioDevice's Init, all on the real-code side:         *)
(* - The log starts when the device is created, with only the device       *)
(*   list's reference (rc = 1). The model starts after                     *)
(*   SDL_AudioDeviceDisconnected took the disconnect reference, so the     *)
(*   main thread gets one extra step, m_disc (that RefPhysicalAudioDevice).*)
(*   Lookups that run before it are ordinary looker steps.                 *)
(* - Lookups that did not find the device (it was gone from the hash) are  *)
(*   left out: in the model they change nothing but their own pc.          *)
(***************************************************************************)
EXTENDS AudioDevice, Sequences, TraceData

VARIABLE i   \* the next log entry to match

TraceInit ==
    /\ rc = 1 + (IF OPEN THEN 1 ELSE 0)
    /\ inhash = TRUE /\ freed = FALSE /\ uaf = FALSE
    /\ pc = [t \in Threads |-> IF t = Main THEN "m_disc" ELSE "l_find"]
    /\ ret = [t \in Threads |-> "none"]
    /\ found = [t \in Lookers |-> FALSE]
    /\ i = 1

\* SDL_AudioDeviceDisconnected's RefPhysicalAudioDevice, before the main-thread handler runs.
MDisc ==
    /\ pc[Main] = "m_disc"
    /\ rc' = rc + 1
    /\ Touch
    /\ Goto(Main, "m_obtain")
    /\ UNCHANGED <<inhash, freed, ret, found>>

E == TraceLog[i]

Step ==
    CASE E.a = "disc_ref"     -> E.t = Main /\ MDisc
      [] E.a = "m_obtain"     -> E.t = Main /\ MObtain
      [] E.a = "m_release"    -> E.t = Main /\ MRelease
      [] E.a = "m_unref_list" -> E.t = Main /\ MUnrefList
      [] E.a = "m_unref_disc" -> E.t = Main /\ MUnrefDisc
      [] E.a = "l_find"       -> E.t \in Lookers /\ LFind(E.t) /\ found'[E.t] = E.ok
      [] E.a = "l_use"        -> E.t \in Lookers /\ LUse(E.t)
      [] E.a = "u_dec"        -> UDec(E.t)
      [] E.a = "u_remove"     -> URemove(E.t)
      [] E.a = "u_free"       -> UFree(E.t)
      [] OTHER                -> FALSE

TraceNext ==
    /\ i <= Len(TraceLog)
    /\ Step
    /\ (E.v >= 0 => rc' = E.v)
    /\ i' = i + 1

TraceSpec == TraceInit /\ [][TraceNext]_<<vars, i>>

\* Checked as an invariant: TLC reports it violated exactly when some behavior has replayed
\* the whole log, which is the success case. TLC runs with deadlock checking off
\* (trace_check.sh). If no behavior reaches the end, TLC finishes with no error, and the trace
\* is not a behavior of the model.
TraceIncomplete == i <= Len(TraceLog)

=============================================================================

------------------------------- MODULE Trace -------------------------------
(***************************************************************************)
(* Trace validation for EventsWait: replay a log from a real run of the    *)
(* instrumented SDL (verification/instrument/events_wait.patch,            *)
(* trace_events.c) and check that every logged step is a step of the      *)
(* model, in the logged order.                                             *)
(*                                                                         *)
(* TraceData (generated by verification/instrument/trace2tla.py) defines:  *)
(*   TraceLog        the steps, each [t, a, v, ok]: "w" for the waiter or  *)
(*                   a producer name, the model action, and its logged     *)
(*                   value (the event count of a GET or ADD, whether a     *)
(*                   swap returned the window, the backend wait's status)  *)
(*   TraceProducers  one model producer per logged push                   *)
(*                                                                         *)
(* What the log cannot show, and how it is matched:                        *)
(* - Why the backend wait returned (a wakeup or some other OS event).      *)
(*   w_wait_ret matches WWaitNative or WWaitTimeout.                       *)
(* - The native event count. It is a model variable that TLC infers.       *)
(* - The fixed code's early timeout: when the timeout has already expired  *)
(*   after an empty queue check, the code clears wakeup_window and returns *)
(*   without calling the backend. The log shows only that clear, which     *)
(*   matches WEnter, WWaitTimeout, then WClear, three steps that change    *)
(*   nothing but the waiter's pc and, in the last one, wakeup_window.      *)
(***************************************************************************)
EXTENDS EventsWait, Sequences, TraceData

VARIABLE i

TraceInit == Init /\ i = 1

EarlyTimeout ==
    /\ wpc = "w_enter"
    /\ TIMED
    /\ ww' = NULL
    /\ wpc' = "w_epump"
    /\ UNCHANGED <<q, native, ppc, swapped, got>>

E == TraceLog[i]

Step ==
    CASE E.a = "w_epump"     -> WEPump
      [] E.a = "w_epeep"     -> IF E.v > 0 THEN WEPeepTake ELSE WEPeepEmpty
      [] E.a = "w_pump"      -> WPump
      [] E.a = "w_peep"      -> IF E.v > 0 THEN WPeepTake ELSE WPeepEmpty
      [] E.a = "w_set"       -> WSet
      [] E.a = "w_untake"    -> WUntake
      [] E.a = "w_enter"     -> WEnter
      [] E.a = "w_wait_ret"  -> WWaitNative \/ WWaitTimeout
      [] E.a = "w_clear"     -> WClear \/ EarlyTimeout
      [] E.a = "p_push"      -> E.t \in Producers /\ PPush(E.t)
      [] E.a = "p_swap"      -> E.t \in Producers /\ PSwap(E.t) /\ (swapped'[E.t] = W) = E.ok
      [] E.a = "p_post"      -> E.t \in Producers /\ PPost(E.t)
      [] OTHER               -> FALSE

TraceNext ==
    /\ i <= Len(TraceLog)
    /\ Step
    /\ i' = i + 1

TraceSpec == TraceInit /\ [][TraceNext]_<<vars, i>>

\* Violated exactly when some behavior has replayed the whole log (the success case). TLC
\* runs with deadlock checking off (trace_check.sh), because branches that guessed wrong where
\* the log underdetermines a step dead-end. If no branch reaches the end, TLC finishes with no
\* error, and the trace is not a behavior of the model.
TraceIncomplete == i <= Len(TraceLog)

=============================================================================
